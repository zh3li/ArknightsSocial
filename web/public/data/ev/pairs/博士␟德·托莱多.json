{"arc":[{"k":"arc","f":"干员档案/德·托莱多","n":116,"t":"“博士，这个小东西真能录下我们所有的对话？","o":"博士"},{"k":"arc","f":"干员档案/德·托莱多","n":123,"t":"“博士，你同意增加投资啦？","o":"博士"}],"voc":[{"k":"voc","f":"干员语音/德·托莱多","n":183,"t":"多谢好意，博士。","o":"博士"},{"k":"voc","f":"干员语音/德·托莱多","n":211,"t":"全体罗德岛干员听令，向博士的兜帽发起进攻！","o":"博士"},{"k":"voc","f":"干员语音/德·托莱多","n":271,"t":"辛苦了，博士，战后总结就交给我来吧。","o":"博士"}]}