{"voc":[{"k":"voc","f":"干员语音/史都华德","n":85,"t":"欢迎回来，博士，史都华德为您效力。","o":"博士"},{"k":"voc","f":"干员语音/史都华德","n":89,"t":"如果是博士您的话，应该可以从这个姓氏中，解读出我的先祖所从事的职业。","o":"博士"},{"k":"voc","f":"干员语音/史都华德","n":97,"t":"博士，您，见过雪吗？","o":"博士"},{"k":"voc","f":"干员语音/史都华德","n":105,"t":"能为博士服务，我感到非常荣幸。","o":"博士"},{"k":"voc","f":"干员语音/史都华德","n":117,"t":"请多多休息吧，明天罗德岛也需要依靠博士您的力量。","o":"博士"},{"k":"voc","f":"干员语音/史都华德","n":197,"t":"有什么我能为您效劳的吗，博士？","o":"博士"},{"k":"voc","f":"干员语音/史都华德","n":205,"t":"有机会的话，真想请博士去看看呢。","o":"博士"},{"k":"voc","f":"干员语音/史都华德","n":209,"t":"请多关照，博士。","o":"博士"},{"k":"voc","f":"干员语音/史都华德","n":213,"t":"博士，生日快乐！","o":"博士"},{"k":"voc","f":"干员语音/史都华德","n":217,"t":"博士，今后也请您多多关照！","o":"博士"}]}