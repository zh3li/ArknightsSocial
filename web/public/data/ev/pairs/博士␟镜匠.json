{"voc":[{"k":"voc","f":"干员语音/镜匠","n":206,"t":"好好休息一下吧，博士。","o":"博士"},{"k":"voc","f":"干员语音/镜匠","n":278,"t":"多亏了博士的指挥，这面盾牌依旧成像清晰，表面平整，没有任何磕碰痕迹。","o":"博士"},{"k":"voc","f":"干员语音/镜匠","n":282,"t":"别灰心嘛，博士！","o":"博士"},{"k":"voc","f":"干员语音/镜匠","n":314,"t":"生日快乐，博士。","o":"博士"},{"k":"voc","f":"干员语音/镜匠","n":318,"t":"就像博士你说的，卡兹戴尔有了镜子，就一定会有宽敞的房屋，未来还会有高楼大厦。","o":"博士"}]}