{"voc":[{"k":"voc","f":"干员语音/奥尔佳","n":183,"t":"啊，博士，交给我就好。","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":187,"t":"这里的装修是您的品味吗，博士？","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":199,"t":"如同那魂牵梦绕的故乡，再也找不到我的痕迹……啊，博士，这是圣骏堡的民谣。","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":219,"t":"辛苦了，博士……不过在乌萨斯的常识里，毯子一定要盖住肩膀……","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":223,"t":"很高兴认识您，博士，我是奥尔佳·达尼洛夫娜·特里波列娃。","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":227,"t":"博士，这是我为作战录像写的学习笔记，您看看——欸，没必要分析风向和挥剑角度的关系吗？","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":259,"t":"请相信您的判断，博士。","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":291,"t":"毫无瑕疵的落幕，博士，您的指挥是值得欣赏的艺术。","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":299,"t":"别担心，博士，我们始终掌握着谈判的筹码。","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":311,"t":"私底下我不介意这样的玩笑，博士。","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":319,"t":"感谢您陪我共度，博士。","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":323,"t":"日安，博士，与您不期而遇，是我今天收获的愉悦。","o":"博士"},{"k":"voc","f":"干员语音/奥尔佳","n":331,"t":"请相信我，博士，在通往理想的道路上，您现在多了一位永不背弃的同伴。","o":"博士"}]}